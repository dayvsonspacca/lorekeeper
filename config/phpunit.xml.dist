<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../vendor/autoload.php"
         colors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnPhpunitNotices="true"
         testdox="true"
         cacheDirectory="../.cache/phpunit">
    <testsuites>
        <testsuite name="core">
            <directory>../packages/core/tests</directory>
        </testsuite>
        <testsuite name="server">
            <directory>../packages/server/tests</directory>
        </testsuite>
        <testsuite name="client">
            <directory>../packages/client/tests</directory>
        </testsuite>
        <testsuite name="bot">
            <directory>../packages/bot/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>../packages/core/src</directory>
            <directory>../packages/server/src</directory>
            <directory>../packages/client/src</directory>
            <directory>../packages/bot/src</directory>
        </include>
    </source>
</phpunit>
