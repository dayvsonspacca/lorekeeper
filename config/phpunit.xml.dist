<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../vendor/autoload.php"
         colors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnPhpunitNotices="true"
         testdox="true"
         cacheDirectory="../.cache/phpunit">
    <testsuites>
        <testsuite name="core">
            <directory>../packages/core/tests</directory>
        </testsuite>
        <testsuite name="protocol">
            <directory>../packages/protocol/tests</directory>
        </testsuite>
        <testsuite name="miner">
            <directory>../packages/miner/tests</directory>
        </testsuite>
        <testsuite name="persistence">
            <directory>../packages/persistence/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>../packages/core/src</directory>
            <directory>../packages/protocol/src</directory>
            <directory>../packages/miner/src</directory>
            <directory>../packages/persistence/src</directory>
        </include>
    </source>
</phpunit>
