{
    "name": "dayvsonspacca/lorekeeper",
    "description": "A toolbox for AdventureQuest Worlds",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Dayvson Spacca",
            "email": "spacca.dayvson@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "packages/core"
        },
        {
            "type": "path",
            "url": "packages/server"
        },
        {
            "type": "path",
            "url": "packages/client"
        },
        {
            "type": "path",
            "url": "packages/bot"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "dayvsonspacca/lorekeeper-core": "dev-main",
        "dayvsonspacca/lorekeeper-server": "dev-main",
        "dayvsonspacca/lorekeeper-client": "dev-main",
        "dayvsonspacca/lorekeeper-bot": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0.5",
        "carthage-software/mago": "~1.16.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Lorekeeper\\Core\\Tests\\": "packages/core/tests/",
            "Lorekeeper\\Server\\Tests\\": "packages/server/tests/",
            "Lorekeeper\\Client\\Tests\\": "packages/client/tests/",
            "Lorekeeper\\Bot\\Tests\\": "packages/bot/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "carthage-software/mago": true
        }
    }
}
